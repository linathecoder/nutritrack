<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEntryWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_slate_900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEntryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_slate_500"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEntryDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="@color/text_slate_700"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/btnEntryEdit"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_edit_action"
        android:contentDescription="Edit entry"
        android:padding="9dp"
        android:src="@drawable/ic_edit" />

    <ImageView
        android:id="@+id/btnEntryDelete"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_delete_action"
        android:contentDescription="Delete entry"
        android:padding="9dp"
        android:src="@drawable/ic_delete" />
</LinearLayout>
