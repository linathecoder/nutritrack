<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analysisRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="Health Analysis"
            android:textColor="@color/text_slate_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp"
            android:src="@drawable/ic_nav_analysis"
            app:tint="@color/nav_active" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/slate_200"
        app:trackCornerRadius="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="48dp">

            <!-- Error banner -->
            <LinearLayout
                android:id="@+id/errorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_error_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/error_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:text="Retry"
                    android:textColor="@color/error_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- SECTION 1: Weight Evolution Line Chart         -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/profile_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weight Evolution"
                                android:textColor="@color/text_slate_900"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWeightSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Past 90 days history"
                                android:textColor="@color/text_slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogWeightQuick"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="+ Log Weight"
                            android:textAllCaps="false"
                            android:textColor="@color/text_slate_900"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="17dp" />
                    </LinearLayout>

                    <!-- Stats overview row -->
                    <LinearLayout
                        android:id="@+id/layoutWeightStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_qty_pill"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current"
                                android:textColor="@color/text_slate_500"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvCurrentWeightStat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="— kg"
                                android:textColor="@color/text_slate_900"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Change"
                                android:textColor="@color/text_slate_500"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvWeightChangeStat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="— kg"
                                android:textColor="@color/nav_active"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Goal"
                                android:textColor="@color/text_slate_500"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvTargetWeightStat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="— kg"
                                android:textColor="@color/text_slate_900"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MPAndroidChart LineChart -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartWeight"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="14dp" />

                    <!-- Empty state if no weight data -->
                    <LinearLayout
                        android:id="@+id/weightEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No weight entries recorded yet"
                            android:textColor="@color/text_slate_700"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap + Log Weight above to record your first entry."
                            android:textColor="@color/text_slate_500"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- SECTION 2: Daily Macro Intake vs Targets       -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/profile_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Intake vs Targets"
                        android:textColor="@color/text_slate_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comparison of today\'s logged nutrition against calculated goals"
                        android:textColor="@color/text_slate_500"
                        android:textSize="12sp" />

                    <!-- Calories comparison row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔥 Calories"
                                android:textColor="@color/text_slate_900"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCaloriesComparison"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 / 2,000 kcal"
                                android:textColor="@color/text_slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressCaloriesComp"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:max="100"
                            app:indicatorColor="@color/primary"
                            app:trackColor="@color/slate_200"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tvCaloriesPercentComp"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%"
                            android:textColor="@color/text_slate_900"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Protein comparison row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥩 Protein"
                                android:textColor="@color/text_slate_900"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProteinComparison"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 / 140g"
                                android:textColor="@color/text_slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressProteinComp"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:max="100"
                            app:indicatorColor="@color/macro_protein"
                            app:trackColor="@color/slate_200"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tvProteinPercentComp"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%"
                            android:textColor="@color/macro_protein"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Carbs comparison row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌾 Carbs"
                                android:textColor="@color/text_slate_900"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCarbsComparison"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 / 220g"
                                android:textColor="@color/text_slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressCarbsComp"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:max="100"
                            app:indicatorColor="@color/macro_carbs"
                            app:trackColor="@color/slate_200"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tvCarbsPercentComp"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%"
                            android:textColor="@color/macro_carbs"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Fat comparison row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥑 Fats"
                                android:textColor="@color/text_slate_900"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFatComparison"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 / 65g"
                                android:textColor="@color/text_slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressFatComp"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:max="100"
                            app:indicatorColor="@color/macro_fat"
                            app:trackColor="@color/slate_200"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tvFatPercentComp"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%"
                            android:textColor="@color/macro_fat"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- SECTION 3: AI Health Analysis of a Product     -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/profile_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✨ AI Health Analysis"
                            android:textColor="@color/text_slate_900"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_profile_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="AI POWERED"
                            android:textColor="@color/nav_active"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nutritional score, deep explanation and macro pairing suggestions."
                        android:textColor="@color/text_slate_500"
                        android:textSize="12sp" />

                    <!-- Product title card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_rounded_square"
                            android:gravity="center"
                            android:text="🥗"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAiProductName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Grilled Salmon &amp; Quinoa Bowl"
                                android:textColor="@color/text_slate_900"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAiProductRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nutrient-Dense • Excellent Balance"
                                android:textColor="@color/nav_active"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAiScoreBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_green"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="Score: 88/100"
                            android:textColor="@color/health_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- AI Explanation Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="AI Health Evaluation"
                        android:textColor="@color/text_slate_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAiExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="High in omega-3 polyunsaturated fatty acids supporting cardiovascular and brain health. Features complete amino acid profile with slow-release complex carbohydrates that stabilize blood sugar."
                        android:textColor="@color/text_slate_700"
                        android:textSize="12.5sp" />

                    <!-- Pairing Suggestion Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_insight_good"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💡 Pairing Suggestion"
                                android:textColor="@color/text_slate_900"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAiPairingSuggestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Pair with steamed broccoli or a fresh citrus salad: vitamin C enhances iron absorption from quinoa, while dietary fiber promotes a diverse microbiome."
                            android:textColor="@color/text_slate_700"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Status Tag: Backend Pending -->
                    <TextView
                        android:id="@+id/tvAiStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Model: AiHealthAnalysis (Backend endpoint GET /api/analysis/ai pending)"
                        android:textColor="@color/text_slate_400"
                        android:textSize="10.5sp"
                        android:textStyle="italic" />

                    <!-- ALWAYS SHOW THIS MANDATORY DISCLAIMER (BR-09) -->
                    <TextView
                        android:id="@+id/tvMedicalDisclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_info_note"
                        android:padding="12dp"
                        android:text="This information is purely informational and does not replace a medical consultation."
                        android:textColor="@color/text_slate_700"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
