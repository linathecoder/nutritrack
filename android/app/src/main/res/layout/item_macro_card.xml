<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMacroEmoji"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_tile"
            android:gravity="center"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMacroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_slate_500"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMacroValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_slate_900"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="3dp"
            android:text="g"
            android:textColor="@color/text_slate_400"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMacroGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal 0g"
        android:textColor="@color/text_slate_400"
        android:textSize="11sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressMacro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        app:trackColor="@color/slate_200"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
