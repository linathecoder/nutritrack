<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIngEmoji"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rounded_square"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIngName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_slate_900"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIngMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_slate_500"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnIngEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_qty_pill"
            android:clickable="true"
            android:contentDescription="Edit amount"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_edit" />

        <ImageView
            android:id="@+id/btnIngRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_qty_pill"
            android:clickable="true"
            android:contentDescription="Remove ingredient"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/slate_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_note"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <FrameLayout
                android:id="@+id/btnIngMinus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_rounded_square"
                android:clickable="true"
                android:contentDescription="Decrease amount"
                android:focusable="true">

                <View
                    android:layout_width="12dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:background="@color/text_slate_900" />
            </FrameLayout>

            <EditText
                android:id="@+id/etIngQty"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:background="@null"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnIngPlus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_rounded_square"
                android:clickable="true"
                android:contentDescription="Increase amount"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_slate_900" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_info_note"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <Spinner
                android:id="@+id/spinnerIngUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:dropDownWidth="260dp"
                android:paddingEnd="18dp"
                android:popupBackground="@drawable/bg_spinner_popup" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_vertical|end"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvIngGrams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_slate_400"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
