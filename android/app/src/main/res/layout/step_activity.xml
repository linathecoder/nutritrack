<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:text="How active are you?"
        android:textColor="@color/text_slate_900"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="Select your level of physical activity outside of exercise during work and leisure time"
        android:textColor="@color/text_slate_500"
        android:textSize="15sp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSedentary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivIconSedentary"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_couch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitleSedentary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Mostly Sedentary"
            android:textColor="@color/text_slate_900"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivRadioSedentary"
            app:layout_constraintStart_toEndOf="@id/ivIconSedentary"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="Commonly under 5,000 steps a day"
            android:textColor="@color/text_slate_500"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/ivRadioSedentary"
            app:layout_constraintStart_toEndOf="@id/ivIconSedentary"
            app:layout_constraintTop_toBottomOf="@id/tvTitleSedentary" />

        <ImageView
            android:id="@+id/ivRadioSedentary"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unselected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardModerate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivIconModerate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_footsteps"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitleModerate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Moderately Active"
            android:textColor="@color/text_slate_900"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivRadioModerate"
            app:layout_constraintStart_toEndOf="@id/ivIconModerate"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="Commonly 5,000 – 15,000 steps a day"
            android:textColor="@color/text_slate_500"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/ivRadioModerate"
            app:layout_constraintStart_toEndOf="@id/ivIconModerate"
            app:layout_constraintTop_toBottomOf="@id/tvTitleModerate" />

        <ImageView
            android:id="@+id/ivRadioModerate"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unselected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivIconActive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_skate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitleActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Very Active"
            android:textColor="@color/text_slate_900"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivRadioActive"
            app:layout_constraintStart_toEndOf="@id/ivIconActive"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="Commonly more than 15,000 steps a day"
            android:textColor="@color/text_slate_500"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/ivRadioActive"
            app:layout_constraintStart_toEndOf="@id/ivIconActive"
            app:layout_constraintTop_toBottomOf="@id/tvTitleActive" />

        <ImageView
            android:id="@+id/ivRadioActive"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unselected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>

