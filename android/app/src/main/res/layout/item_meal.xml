<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <!-- Actions sit behind the meal card and are revealed by swiping left. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMealEdit"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_edit_action"
            android:contentDescription="Edit meal"
            android:padding="14dp"
            android:src="@drawable/ic_edit"
            android:tint="#168A43" />

        <ImageButton
            android:id="@+id/btnMealDelete"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_delete_action"
            android:contentDescription="Delete meal"
            android:padding="14dp"
            android:src="@drawable/ic_close_circle"
            android:tint="#D92D20" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mealForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivMealImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_qty_pill"
            android:clipToOutline="true"
            android:contentDescription="Food photo"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMealName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMealMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_slate_500"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMealTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_slate_400"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMealQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_qty_pill"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_slate_700"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
