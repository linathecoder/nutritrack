<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.NutriTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_slate_900</item>
        <item name="android:statusBarColor">#1B4D25</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <style name="Theme.NutriTrack" parent="Base.Theme.NutriTrack" />

    <style name="ThemeOverlay.NutriTrack.NumberPicker" parent="">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="editTextColor">@color/black</item>
    </style>

    <style name="ShapeAppearance.NutriTrack.RoundedBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">40dp</item>
        <item name="cornerSizeBottomRight">40dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>
</resources>
